# ============================================
# Data Stream Flow - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAG_DIR_LIST_INTERVAL=30
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:test_password@postgres:5432/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_PRE_PING=True
AIRFLOW__CORE__LOGGING_LEVEL=INFO
AIRFLOW__CORE__DAG_CONCURRENCY=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=3
AIRFLOW__CORE__PARALLELISM=16

# ============================================
# Email / SMTP Configuration
# ============================================
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=test@test.com
AIRFLOW__SMTP__SMTP_PASSWORD=test
AIRFLOW__SMTP__SMTP_MAIL_FROM=test@test.com

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=test_password
POSTGRES_DB=airflow
AIRFLOW_DB_PASSWORD=test_password

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION_NAME=us-east-1

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_CLUSTER_NAME=datastreamflow
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
PIPELINE_SCHEDULE_INTERVAL=@hourly
COMPOSE_PROJECT_NAME=datastreamflow

# ============================================
# Security Configuration
# ============================================
AIRFLOW_SECRET_KEY=test_secret_key
AIRFLOW_WEBSERVER_SECRET_KEY=test_web_secret_key
AIRFLOW_API_PASSWORD=test_api_password

# ============================================
# Slack Notifications (Optional)
# ============================================
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#data-pipeline
SLACK_USERNAME=DataPipelineBot

# ============================================
# Resource Limits
# ============================================
AIRFLOW_CPU_LIMIT=2
AIRFLOW_MEMORY_LIMIT=2g
SPARK_MEMORY_LIMIT=4g
KAFKA_MEMORY_LIMIT=2g
MINIO_MEMORY_LIMIT=1g
ELASTICSEARCH_MEMORY_LIMIT=1g
NETWORK_SUBNET=172.28.0.0/16

# ============================================
# Grafana Configuration
# ============================================
GRAFANA_PASSWORD=test_grafana

# ============================================
# SMTP Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_USER=test@test.com
SMTP_PASSWORD=test
SMTP_FROM=test@test.com
